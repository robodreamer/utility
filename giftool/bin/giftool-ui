    def source_panel(self) -> None:
        with ui.column().classes("panel gap-4"):
            ui.label("Single Source").classes("section-title")
            self.source_upload = ui.upload(on_upload=self.handle_upload, auto_upload=True).props(
                'accept=".gif,.mp4,.m4v,.mov,.webm,video/*,image/gif"'
            ).classes("hidden")
            self.path_input = ui.input("Local path").props("outlined dense clearable").classes("w-full")
            with ui.row().classes("w-full gap-2"):
                ui.button("Load File", icon="upload_file").props("unelevated").classes("grow").on(
                    "click",
                    js_handler=f'() => runMethod({self.source_upload.id}, "pickFiles", [])',
                )
                ui.button("Load Path", icon="folder_open", on_click=self.load_path).props("outline").classes("grow")
                ui.button("Reset", icon="restart_alt", on_click=self.reset).props("outline").classes("grow")

            ui.separator()
            self.meta = ui.column().classes("gap-1 w-full")
            self.refresh_meta()

            ui.separator()
            ui.label("Comparison").classes("section-title")
            self.compare_upload = ui.upload(on_upload=self.handle_compare_upload, auto_upload=True).props(
                'accept=".gif,.mp4,.m4v,.mov,.webm,video/*,image/gif"'
            ).classes("hidden")
            self.compare_path_input = ui.input("Second media path").props("outlined dense clearable").classes(
                "w-full"
            )
            with ui.row().classes("w-full gap-2"):
                ui.button("Load Second", icon="video_library").props("outline").classes("grow").on(
                    "click",
                    js_handler=f'() => runMethod({self.compare_upload.id}, "pickFiles", [])',
                )
                ui.button("Load Path", icon="folder_open", on_click=self.load_compare_path).props(
                    "outline"
                ).classes("grow")
                ui.button("Clear", icon="close", on_click=self.clear_compare).props("outline").classes("grow")
            self.compare_meta = ui.column().classes("gap-1 w-full")
            self.refresh_compare_meta()

            ui.separator()
            ui.label("Combine Clips").classes("section-title")
            self.join_upload = ui.upload(on_upload=self.handle_join_upload, auto_upload=True).props(
                'multiple accept=".gif,.mp4,.m4v,.mov,.webm,video/*,image/gif"'
            ).classes("hidden")
            self.join_paths_input = ui.textarea("Clip paths (one per line)").props(
                "outlined dense clearable"
            ).classes("w-full")
            with ui.row().classes("w-full gap-2"):
                ui.button("Add Files", icon="playlist_add").props("outline").classes("grow").on(
                    "click",
                    js_handler=f'() => runMethod({self.join_upload.id}, "pickFiles", [])',
                )
                ui.button("Load Paths", icon="folder_open", on_click=self.load_join_paths_from_input).props(
                    "outline"
                ).classes("grow")
                ui.button("Clear", icon="close", on_click=self.clear_join).props("outline").classes("grow")
            self.join_preview_button = ui.button(
                "Preview Join", icon="play_circle", on_click=self.preview_join
            ).props("outline disabled").classes("w-full")
            self.join_meta = ui.column().classes("gap-1 w-full")
            self.refresh_join_meta()

            ui.separator()
            self.output_input = ui.input("Output path").props("outlined dense").classes("w-full")
            with ui.row().classes("w-full gap-2"):
                ui.button("Choose Output", icon="folder_open", on_click=self.choose_output_path).props(
                    "outline"
                ).classes("grow")
                ui.button("Default Path", icon="drive_file_move", on_click=self.use_default_output_path).props(
                    "outline"
                ).classes("grow")
                self.open_output_button = ui.button(
                    "ffplay", icon="play_circle", on_click=self.open_output_external
                ).props("outline disabled").classes("grow")
                self.download_button = ui.button(
                    "Browser Download", icon="download", on_click=self.download_output
                ).props("outline disabled").classes("grow")
            self.output_meta = ui.label("No output rendered.").classes("muted")
            self.save_copy_input = ui.input("Save rendered copy to path").props("outlined dense clearable").classes(
                "w-full"
            )
            with ui.row().classes("w-full gap-2"):
                ui.button("Choose Path", icon="folder_open", on_click=self.choose_save_copy_path).props(
                    "outline"
                ).classes("grow")
                self.save_copy_button = ui.button(
                    "Save Copy", icon="save_as", on_click=self.save_output_copy
                ).props("outline disabled").classes("grow")

    @ui.refreshable
    def preview_panel(self) -> None:
        self.source_video = None
        self.compare_video = None
        self.gif_frame_image = None
        self.trim_label = None
        self.start_slider = None
        self.end_slider = None
        self.scrub_slider = None
        self.start_input = None
        self.end_input = None
        self.scrub_input = None
        self.compare_trim_label = None
        self.compare_start_slider = None
        self.compare_end_slider = None
        self.compare_scrub_slider = None
        self.compare_start_input = None
        self.compare_end_input = None
        self.compare_scrub_input = None
        self.join_videos = {}
        self.join_trim_controls = {}
        with ui.column().classes("panel gap-4"):
            with ui.row().classes("items-center justify-between w-full"):
                ui.label("Preview").classes("section-title")
                preview_info = self.output_info()
                if preview_info is not None:
                    ui.label(preview_info.path.name).classes("muted")

            if self.join_active():
                self.join_clip_preview_tabs()
            elif self.info is None:
                with ui.element("div").classes("preview-surface"):
                    with ui.column().classes("empty-preview items-center gap-2"):
                        ui.icon("movie").classes("text-5xl")
                        ui.label("No media loaded")
            elif self.compare_info is not None:
                with ui.tabs().classes("w-full") as tabs:
                    source_tab = ui.tab("Source")
                    compare_tab = ui.tab("Second")
                with ui.tab_panels(tabs, value=source_tab).classes("w-full").props("animated"):
                    with ui.tab_panel(source_tab).classes("preview-tab-panel"):
                        self.source_preview_tab()
                    with ui.tab_panel(compare_tab).classes("preview-tab-panel"):
                        self.compare_preview_tab()
            else:
                self.source_preview_tab()

            if self.join_preview_path:
                ui.label("Join Preview").classes("section-title")
                with ui.element("div").classes("preview-surface"):
                    join_video = ui.video(self.join_preview_path).props("controls preload=metadata muted").classes(
                        "media-view"
                    )
                    join_video.on(
                        "error",
                        self.on_output_media_error,
                        js_handler=f"() => emit(window.giftoolRecoverMedia({join_video.id}))",
                    )

            if self.output_path:
                ui.label("Rendered Output").classes("section-title")
                with ui.element("div").classes("preview-surface"):
                    if self.output_path.suffix.lower() == ".gif":
                        self.gif_preview(self.output_path)
                    else:
                        output_video = ui.video(self.output_path).props("controls preload=metadata muted").classes(
                            "media-view"
                        )
                        output_video.on(
                            "error",
                            self.on_output_media_error,
                            js_handler=f"() => emit(window.giftoolRecoverMedia({output_video.id}))",
                        )

    def gif_preview(self, path: Path) -> None:
        ui.element("img").props(f'src="{static_file_url(path)}"').classes("media-view")

    async def prepare_gif_preview(self, info: MediaInfo) -> None:
        self.gif_preview_path = None
        self.gif_preview_frames = []
        self.gif_preview_frame_starts = []
        preview_files = await asyncio.to_thread(extract_gif_preview_files, info.path, info.duration)
        self.gif_preview_frames = [
            GifPreviewFrame(item.start, item.end, item.path, static_file_url(item.path)) for item in preview_files
        ]
        self.gif_preview_frame_starts = [item.start for item in self.gif_preview_frames]
        self.gif_preview_path = info.path

    def gif_frame_for_time(self, timestamp: float) -> GifPreviewFrame | None:
        if not self.gif_preview_frames:
            return None
        index = bisect.bisect_right(self.gif_preview_frame_starts, max(0.0, timestamp)) - 1
        index = max(0, min(index, len(self.gif_preview_frames) - 1))
        return self.gif_preview_frames[index]

    def gif_frame_preview(self) -> None:
        if self.info is None:
            return
        frame = self.gif_frame_for_time(self.scrub_time)
        if frame is None:
            ui.label("GIF preview unavailable").classes("empty-preview")
            return
        self.gif_frame_image = (
            ui.element("img").props(f'src="{frame.url}" loading=eager decoding=async').classes("media-view")
        )

    def update_gif_frame_preview(self) -> None:
        if self.info is None or self.info.kind != "gif" or self.gif_frame_image is None:
            return
        frame = self.gif_frame_for_time(self.scrub_time)
        if frame is None:
            return
        if self.gif_frame_image.props.get("src") == frame.url:
            return
        self.gif_frame_image.props["src"] = frame.url
        self.gif_frame_image.update()

    def source_preview_tab(self) -> None:
        with ui.column().classes("preview-tab-content gap-4"):
            with ui.element("div").classes("preview-surface"):
                if self.info is None:
                    return
                if self.info.kind == "gif" and self.gif_video_preview_path is None:
                    self.gif_frame_preview()
                else:
                    source_path = self.gif_video_preview_path if self.info.kind == "gif" else self.info.path
                    self.source_video = ui.video(source_path).props("controls preload=metadata muted").classes(
                        "media-view"
                    )
                    self.source_video.on(
                        "error",
                        self.on_source_media_error,
                        js_handler=f"() => emit(window.giftoolRecoverMedia({self.source_video.id}))",
                    )
                    self.source_video.on(
                        "timeupdate",
                        self.on_preview_time_update,
                        js_handler="(event) => emit(event.target.currentTime)",
                        throttle=0.1,
                    )
            self.source_trim_controls()

    def compare_preview_tab(self) -> None:
        if self.compare_info is None:
            return
        with ui.column().classes("preview-tab-content gap-4"):
            with ui.element("div").classes("preview-surface"):
                compare_path = (
                    self.compare_video_preview_path
                    if self.compare_info.kind == "gif" and self.compare_video_preview_path is not None
                    else self.compare_info.path
                )
                if self.compare_info.kind == "gif" and self.compare_video_preview_path is None:
                    self.gif_preview(self.compare_info.path)
                else:
                    self.compare_video = ui.video(compare_path).props("controls preload=metadata muted").classes(
                        "media-view"
                    )
                    self.compare_video.on(
                        "error",
                        self.on_compare_media_error,
                        js_handler=f"() => emit(window.giftoolRecoverMedia({self.compare_video.id}))",
                    )
                    self.compare_video.on(
                        "timeupdate",
                        self.on_compare_time_update,
                        js_handler="(event) => emit(event.target.currentTime)",
                        throttle=0.1,
                    )
            self.compare_trim_controls()

    def join_clip_preview_tabs(self) -> None:
        if not self.join_infos:
            return
        self.join_selected_index = min(self.join_selected_index, len(self.join_infos) - 1)
        options = {index: f"{index + 1}. {info.path.name}" for index, info in enumerate(self.join_infos)}
        ui.select(
            options,
            value=self.join_selected_index,
            label="Clip to preview and trim",
            on_change=lambda e: self.select_join_clip(int(e.value)),
        ).props("outlined dense").classes("w-full")
        self.join_clip_preview_tab(self.join_selected_index)

    def select_join_clip(self, index: int) -> None:
        if index < 0 or index >= len(self.join_infos) or index == self.join_selected_index:
            return
        self.join_selected_index = index
        self.preview_panel.refresh()

    def join_clip_preview_tab(self, index: int) -> None:
        info = self.join_infos[index]
        duration = max(0.01, info.duration)
        start = max(0.0, min(self.join_start_times[index], duration))
        end = max(start, min(self.join_end_times[index], duration))
        scrub = max(start, min(self.join_scrub_times[index], end))
        with ui.column().classes("preview-tab-content gap-4"):
            with ui.element("div").classes("preview-surface"):
                preview_path = self.join_video_preview_paths[index]
                if info.kind == "gif" and preview_path is None:
                    self.gif_preview(info.path)
                else:
                    video_path = preview_path if preview_path is not None else info.path
                    video = ui.video(video_path).props("controls preload=metadata muted").classes("media-view")
                    self.join_videos[index] = video
                    video.on(
                        "error",
                        self.on_output_media_error,
                        js_handler=f"() => emit(window.giftoolRecoverMedia({video.id}))",
                    )
                    video.on(
                        "timeupdate",
                        lambda e, i=index: self.on_join_time_update(i, e),
                        js_handler="(event) => emit(event.target.currentTime)",
                        throttle=0.2,
                    )

            with ui.column().classes("trim-controls gap-3"):
                ui.label(f"Trim clip {index + 1}").classes("section-title")
                label = ui.label(self.join_trim_text(index)).classes("muted")
                start_slider = ui.slider(
                    min=0.0,
                    max=duration,
                    value=start,
                    step=0.01,
                    on_change=lambda e, i=index: self.set_join_clip_start(i, e.value),
                ).props("label-always")
                end_slider = ui.slider(
                    min=0.0,
                    max=duration,
                    value=end,
                    step=0.01,
                    on_change=lambda e, i=index: self.set_join_clip_end(i, e.value),
                ).props("label-always")
                with ui.row().classes("w-full gap-2"):
                    start_input = ui.number(
                        "Start",
                        value=round(start, 3),
                        min=0.0,
                        max=duration,
                        step=0.1,
                        on_change=lambda e, i=index: self.set_join_clip_start(i, e.value),
                    ).props("outlined dense suffix=s").classes("grow")
                    end_input = ui.number(
                        "End",
                        value=round(end, 3),
                        min=0.0,
                        max=duration,
                        step=0.1,
                        on_change=lambda e, i=index: self.set_join_clip_end(i, e.value),
                    ).props("outlined dense suffix=s").classes("grow")
                ui.label("Preview Position").classes("section-title")
                scrub_slider = ui.slider(
                    min=start,
                    max=end,
                    value=scrub,
                    step=0.01,
                    on_change=lambda e, i=index: self.set_join_clip_scrub(i, e.value),
                ).props("label-always")
                scrub_input = ui.number(
                    "Scrub",
                    value=round(scrub, 3),
                    min=start,
                    max=end,
                    step=0.1,
                    on_change=lambda e, i=index: self.set_join_clip_scrub(i, e.value),
                ).props("outlined dense suffix=s").classes("w-full")
                with ui.row().classes("w-full gap-2"):
                    ui.button(
                        "Play Selected", icon="play_arrow", on_click=lambda i=index: self.play_join_clip(i)
                    ).props("unelevated").classes("grow")
                    ui.button(
                        "Loop Selected", icon="repeat", on_click=lambda i=index: self.play_join_clip(i, loop=True)
                    ).props("outline").classes("grow")
                    ui.button("Pause", icon="pause", on_click=lambda i=index: self.pause_join_clip(i)).props(
                        "outline"
                    ).classes("grow")
                    ui.button("Full Range", icon="select_all", on_click=lambda i=index: self.full_join_clip(i)).props(
                        "outline"
                    ).classes("grow")
                self.join_trim_controls[index] = {
                    "label": label,
                    "start_slider": start_slider,
                    "end_slider": end_slider,
                    "start_input": start_input,
                    "end_input": end_input,
                    "scrub_slider": scrub_slider,
                    "scrub_input": scrub_input,
                }

    def join_trim_text(self, index: int) -> str:
        selected = max(0.0, self.join_end_times[index] - self.join_start_times[index])
        return (
            f"{format_seconds(self.join_start_times[index])} to "
            f"{format_seconds(self.join_end_times[index])} ({format_seconds(selected)})"
        )

    def sync_join_trim_controls(self, index: int) -> None:
        controls = self.join_trim_controls.get(index)
        if controls is None:
            return
        self.join_trim_syncing = True
        try:
            start = self.join_start_times[index]
            end = self.join_end_times[index]
            scrub = self.join_scrub_times[index]
            controls["start_slider"].set_value(start)
            controls["end_slider"].set_value(end)
            controls["start_input"].set_value(round(start, 3))
            controls["end_input"].set_value(round(end, 3))
            controls["scrub_slider"].props["min"] = start
            controls["scrub_slider"].props["max"] = end
            controls["scrub_input"].props["min"] = start
            controls["scrub_input"].props["max"] = end
            controls["scrub_slider"].set_value(scrub)
            controls["scrub_input"].set_value(round(scrub, 3))
            controls["label"].set_text(self.join_trim_text(index))
        finally:
            self.join_trim_syncing = False

    def join_trim_changed(self, index: int) -> None:
        self.join_revision += 1
        self.invalidate_rendered_join_output()
        self.sync_join_trim_controls(index)
        self.refresh_join_meta()

    def set_join_clip_start(self, index: int, value: Any) -> None:
        if self.join_trim_syncing or index >= len(self.join_infos):
            return
        duration = max(0.0, self.join_infos[index].duration)
        start = max(0.0, min(parse_number(value), duration))
        self.join_start_times[index] = start
        if self.join_end_times[index] < start:
            self.join_end_times[index] = start
        self.join_scrub_times[index] = max(start, min(self.join_scrub_times[index], self.join_end_times[index]))
        self.join_trim_changed(index)

    def set_join_clip_end(self, index: int, value: Any) -> None:
        if self.join_trim_syncing or index >= len(self.join_infos):
            return
        duration = max(0.0, self.join_infos[index].duration)
        end = max(0.0, min(parse_number(value), duration))
        self.join_end_times[index] = end
        if self.join_start_times[index] > end:
            self.join_start_times[index] = end
        self.join_scrub_times[index] = max(self.join_start_times[index], min(self.join_scrub_times[index], end))
        self.join_trim_changed(index)

    async def set_join_clip_scrub(self, index: int, value: Any) -> None:
        if self.join_trim_syncing or index >= len(self.join_infos):
            return
        start = self.join_start_times[index]
        end = self.join_end_times[index]
        scrub = max(start, min(parse_number(value), end))
        if abs(scrub - self.join_scrub_times[index]) < 0.03:
            return
        self.join_scrub_times[index] = scrub
        self.sync_join_trim_controls(index)
        video = self.join_videos.get(index)
        if video is not None:
            await self.run_preview_script(f"return window.giftoolSeekTrim({video.id}, {scrub:.6f})")

    def on_join_time_update(self, index: int, event: events.GenericEventArguments) -> None:
        if index >= len(self.join_infos):
            return
        raw_value = event.args[0] if isinstance(event.args, list) and event.args else event.args
        start = self.join_start_times[index]
        end = self.join_end_times[index]
        self.join_scrub_times[index] = max(start, min(parse_number(raw_value, start), end))
        self.sync_join_trim_controls(index)

    async def play_join_clip(self, index: int, loop: bool = False) -> None:
        video = self.join_videos.get(index)
        if video is None:
            ui.notify("This clip does not have a playable video preview.", type="warning")
            return
        start = self.join_start_times[index]
        end = self.join_end_times[index]
        if end <= start:
            ui.notify("Clip end time must be greater than start time.", type="warning")
            return
        preview_start = self.join_scrub_times[index] if start <= self.join_scrub_times[index] < end else start
        ok = await self.run_preview_script(
            "return window.giftoolPlayTrim("
            f"{video.id}, {preview_start:.6f}, {end:.6f}, {str(loop).lower()}, {start:.6f})"
        )
        if not ok:
            ui.notify("Could not start the clip preview.", type="negative")

    async def pause_join_clip(self, index: int) -> None:
        video = self.join_videos.get(index)
        if video is not None:
            await self.run_preview_script(f"return window.giftoolPauseTrim({video.id})")

    def full_join_clip(self, index: int) -> None:
        if index >= len(self.join_infos):
            return
        self.join_start_times[index] = 0.0
        self.join_end_times[index] = self.join_infos[index].duration
        self.join_scrub_times[index] = 0.0
        self.join_trim_changed(index)

    def source_trim_controls(self) -> None:
        duration = max(0.01, self.info.duration if self.info else 1.0)
        start = min(self.start_time, duration)
        end = self.end_time if self.end_time > 0 else duration
        end = min(max(start, end), duration)
        scrub_min, scrub_max = self.scrub_bounds()
        scrub = min(max(self.scrub_time, scrub_min), scrub_max)

        with ui.column().classes("trim-controls gap-3"):
            ui.label("Trim").classes("section-title")
            self.trim_label = ui.label(self.trim_text()).classes("muted")
            self.start_slider = ui.slider(
                min=0.0,
                max=duration,
                value=start,
                step=0.01,
                on_change=lambda e: self.set_start(e.value),
            ).props("label-always")
            self.end_slider = ui.slider(
                min=0.0,
                max=duration,
                value=end,
                step=0.01,
                on_change=lambda e: self.set_end(e.value),
            ).props("label-always")
            with ui.row().classes("w-full gap-2"):
                self.start_input = ui.number(
                    "Start",
                    value=round(start, 3),
                    min=0.0,
                    step=0.1,
                    on_change=lambda e: self.set_start(e.value),
                ).props("outlined dense suffix=s").classes("grow")
                self.end_input = ui.number(
                    "End",
                    value=round(end, 3),
                    min=0.0,
                    step=0.1,
                    on_change=lambda e: self.set_end(e.value),
                ).props("outlined dense suffix=s").classes("grow")
            with ui.row().classes("w-full gap-2"):
                ui.button("Full Range", icon="select_all", on_click=self.full_range).props("outline").classes("grow")
                ui.button("Set 5s Clip", icon="timer", on_click=self.set_five_second_clip).props("outline").classes(
                    "grow"
                )
            if self.info is not None:
                ui.label("Preview Position").classes("section-title")
                self.scrub_slider = ui.slider(
                    min=scrub_min,
                    max=scrub_max,
                    value=scrub,
                    step=0.01,
                    on_change=lambda e: self.set_scrub(e.value),
                ).props("label-always")
                self.scrub_input = ui.number(
                    "Scrub",
                    value=round(scrub, 3),
                    min=scrub_min,
                    max=scrub_max,
                    step=0.1,
                    on_change=lambda e: self.set_scrub(e.value),
                ).props("outlined dense suffix=s").classes("w-full")
            if self.info is not None and self.info.kind == "video":
                with ui.row().classes("w-full gap-2"):
                    ui.button("Play Once", icon="play_arrow", on_click=self.play_trim_range).props(
                        "unelevated"
                    ).classes("grow")
                    ui.button("Loop Range", icon="repeat", on_click=self.loop_trim_range).props("outline").classes(
                        "grow"
                    )
                    ui.button("Pause", icon="pause", on_click=self.pause_trim_preview).props("outline").classes(
                        "grow"
                    )
            elif self.info is not None and self.info.kind == "gif":
                with ui.row().classes("w-full gap-2"):
                    ui.button("Play Once", icon="play_arrow", on_click=self.play_gif_range).props(
                        "unelevated"
                    ).classes("grow")
                    ui.button("Loop Range", icon="repeat", on_click=self.loop_gif_range).props("outline").classes(
                        "grow"
                    )
                    ui.button("Pause", icon="pause", on_click=self.pause_gif_preview).props("outline").classes(
                        "grow"
                    )

    def compare_trim_controls(self) -> None:
        compare_duration = max(0.01, self.compare_info.duration if self.compare_info else 1.0)
        compare_start = min(self.compare_start_time, compare_duration)
        compare_end = self.compare_end_time if self.compare_end_time > 0 else compare_duration
        compare_end = min(max(compare_start, compare_end), compare_duration)
        compare_scrub_min, compare_scrub_max = self.compare_scrub_bounds()
        compare_scrub = min(max(self.compare_scrub_time, compare_scrub_min), compare_scrub_max)

        with ui.column().classes("trim-controls gap-3"):
            ui.label("Second Trim").classes("section-title")
            self.compare_trim_label = ui.label(self.compare_trim_text()).classes("muted")
            self.compare_start_slider = ui.slider(
                min=0.0,
                max=compare_duration,
                value=compare_start,
                step=0.01,
                on_change=lambda e: self.set_compare_start(e.value),
            ).props("label-always")
            self.compare_end_slider = ui.slider(
                min=0.0,
                max=compare_duration,
                value=compare_end,
                step=0.01,
                on_change=lambda e: self.set_compare_end(e.value),
            ).props("label-always")
            with ui.row().classes("w-full gap-2"):
                self.compare_start_input = ui.number(
                    "Start",
                    value=round(compare_start, 3),
                    min=0.0,
                    step=0.1,
                    on_change=lambda e: self.set_compare_start(e.value),
                ).props("outlined dense suffix=s").classes("grow")
                self.compare_end_input = ui.number(
                    "End",
                    value=round(compare_end, 3),
                    min=0.0,
                    step=0.1,
                    on_change=lambda e: self.set_compare_end(e.value),
                ).props("outlined dense suffix=s").classes("grow")
            with ui.row().classes("w-full gap-2"):
                ui.button("Full Range", icon="select_all", on_click=self.full_compare_range).props("outline").classes(
                    "grow"
                )
                ui.button("Set 5s Clip", icon="timer", on_click=self.set_compare_five_second_clip).props(
                    "outline"
                ).classes("grow")
            ui.label("Second Preview Position").classes("section-title")
            self.compare_scrub_slider = ui.slider(
                min=compare_scrub_min,
                max=compare_scrub_max,
                value=compare_scrub,
                step=0.01,
                on_change=lambda e: self.set_compare_scrub(e.value),
            ).props("label-always")
            self.compare_scrub_input = ui.number(
                "Scrub",
                value=round(compare_scrub, 3),
                min=compare_scrub_min,
                max=compare_scrub_max,
                step=0.1,
                on_change=lambda e: self.set_compare_scrub(e.value),
            ).props("outlined dense suffix=s").classes("w-full")
            with ui.row().classes("w-full gap-2"):
                ui.button("Play Second", icon="play_arrow", on_click=self.play_compare_trim_range).props(
                    "unelevated"
                ).classes("grow")
                ui.button("Loop Second", icon="repeat", on_click=self.loop_compare_trim_range).props(
                    "outline"
                ).classes("grow")
                ui.button("Pause Second", icon="pause", on_click=self.pause_compare_trim_preview).props(
                    "outline"
                ).classes("grow")

    @ui.refreshable
    def controls_panel(self) -> None:
        self.output_format_select = None
        self.loop_input = None
        self.caption_input = None
        self.text_position_select = None
        self.text_size_input = None
        self.side_by_side_checkbox = None
        self.combine_checkbox = None
        self.label_left_input = None
        self.label_right_input = None
        self.crf_slider = None
        self.preset_select = None
        self.copy_checkbox = None
        active_info = self.output_info()

        with ui.column().classes("panel gap-4"):
            ui.label("Output").classes("section-title")
            with ui.row().classes("w-full gap-2"):
                self.width_input = ui.number(
                    "Width",
                    min=1,
                    step=2,
                    on_change=lambda e: self.set_output_width(e.value),
                ).props("outlined dense suffix=px").classes("grow")
                self.height_input = ui.number(
                    "Height",
                    min=1,
                    step=2,
                    on_change=lambda e: self.set_output_height(e.value),
                ).props("outlined dense suffix=px").classes("grow")
            ui.label("Scale").classes("muted")
            with ui.row().classes("w-full gap-2 items-center"):
                self.resize_scale_slider = ui.slider(
                    min=10,
                    max=100,
                    value=100,
                    step=5,
                    on_change=lambda e: self.set_output_scale(e.value),
                ).props("label-always").classes("grow")
                self.resize_scale_input = ui.number(
                    "Scale",
                    value=100,
                    min=10,
                    max=100,
                    step=5,
                    on_change=lambda e: self.set_output_scale(e.value),
                ).props("outlined dense suffix=%").classes("w-24")
            self.output_size_label = ui.label("Output: -").classes("muted")
            if active_info is not None:
                self.output_format_select = ui.select(
                    {"auto": "Auto", "gif": "GIF", "mp4": "MP4"},
                    value=self.output_format_select_value(),
                    label="Output format",
                    on_change=lambda e: self.set_output_format(e.value),
                ).props("outlined dense").classes("w-full")
                if self.side_by_side_active() or self.join_active():
                    self.output_format_select.disable()
            self.fps_input = ui.input("FPS").props("outlined dense").classes("w-full")

            compare_ready = self.info is not None and self.compare_info is not None and not self.join_active()
            join_ready = bool(self.join_paths)
            mp4_output = self.mp4_output_active()

            if active_info is None or (active_info.kind == "gif" and not mp4_output):
                self.loop_input = ui.input("Loop count").props("outlined dense").classes("w-full")
                self.loop_input.set_value("0")

            if join_ready:
                ui.separator()
                ui.label("Joining").classes("section-title")
                self.combine_checkbox = ui.checkbox(
                    "Combine clips in order",
                    value=bool(self.join_enabled),
                    on_change=lambda e: self.set_join_enabled(e.value),
                )
                ui.label("The ordered clip list is the source; each clip has its own trim controls.").classes("muted")

            if self.info is not None and not self.join_active() and (self.info.kind == "video" or compare_ready):
                ui.separator()
                ui.label("Comparison").classes("section-title")
                self.side_by_side_checkbox = ui.checkbox(
                    "Side-by-side comparison",
                    value=bool(compare_ready and self.compare_enabled),
                    on_change=lambda e: self.set_compare_enabled(e.value),
                )
                if not compare_ready:
                    self.side_by_side_checkbox.disable()
                    ui.label("Load second media to enable comparison output.").classes("muted")
                with ui.row().classes("w-full gap-2"):
                    self.label_left_input = ui.input("Left label").props("outlined dense").classes("grow")
                    self.label_right_input = ui.input("Right label").props("outlined dense").classes("grow")
                self.label_left_input.set_value("Before")
                self.label_right_input.set_value("After")

            if mp4_output:
                ui.separator()
                ui.label("Annotation").classes("section-title")
                ui.label("Full-video caption").classes("muted")
                self.caption_input = ui.input(
                    "Caption/subtitle",
                    value=self.caption_text,
                    on_change=lambda e: self.set_caption_text(e.value),
                ).props("outlined dense clearable").classes("w-full")
                with ui.row().classes("w-full gap-2"):
                    self.text_position_select = ui.select(
                        ["bottom", "top", "center"],
                        value=self.caption_position,
                        label="Caption position",
                        on_change=lambda e: self.set_caption_position(e.value),
                    ).props("outlined dense").classes("grow")
                    self.text_size_input = ui.number(
                        "Text size",
                        value=self.caption_size,
                        min=12,
                        max=96,
                        step=2,
                        on_change=lambda e: self.set_caption_size(e.value),
                    ).props("outlined dense").classes("grow")

                ui.label("Timed overlays").classes("section-title")
                timeline_duration = self.output_timeline_duration()
                ui.label(
                    f"Times use the final output timeline ({format_seconds(timeline_duration)} currently)."
                ).classes("muted")
                for index, overlay in enumerate(self.text_overlays):
                    with ui.card().classes("w-full gap-2 shadow-none border"):
                        with ui.row().classes("w-full items-center gap-2"):
                            ui.label(f"Overlay {index + 1}").classes("section-title grow")
                            ui.button(
                                icon="close", on_click=lambda i=index: self.remove_text_overlay(i)
                            ).props("flat dense")
                        ui.input(
                            "Text",
                            value=overlay.text,
                            on_change=lambda e, i=index: self.update_text_overlay(i, "text", e.value),
                        ).props("outlined dense clearable").classes("w-full")
                        with ui.row().classes("w-full gap-2"):
                            ui.number(
                                "Start",
                                value=overlay.start,
                                min=0,
                                step=0.1,
                                on_change=lambda e, i=index: self.update_text_overlay(i, "start", e.value),
                            ).props("outlined dense suffix=s").classes("grow")
                            ui.number(
                                "End",
                                value=overlay.end,
                                min=0,
                                step=0.1,
                                on_change=lambda e, i=index: self.update_text_overlay(i, "end", e.value),
                            ).props("outlined dense suffix=s").classes("grow")
                        with ui.row().classes("w-full gap-2"):
                            ui.select(
                                ["bottom", "top", "center"],
                                value=overlay.position,
                                label="Position",
                                on_change=lambda e, i=index: self.update_text_overlay(i, "position", e.value),
                            ).props("outlined dense").classes("grow")
                            ui.number(
                                "Text size",
                                value=overlay.size,
                                min=12,
                                max=96,
                                step=2,
                                on_change=lambda e, i=index: self.update_text_overlay(i, "size", e.value),
                            ).props("outlined dense").classes("grow")
                ui.button("Add Timed Overlay", icon="add", on_click=self.add_text_overlay).props(
                    "outline"
                ).classes("w-full")

                ui.separator()
                self.crf_slider = ui.slider(min=16, max=30, value=20, step=1).props("label-always")
                ui.label("CRF quality").classes("muted")
                self.preset_select = ui.select(
                    ["veryfast", "faster", "fast", "medium", "slow", "slower"],
                    value="medium",
                    label="H.264 preset",
                ).props("outlined dense").classes("w-full")
                self.copy_checkbox = ui.checkbox("Fast copy mode")
                if (
                    active_info is None
                    or active_info.kind != "video"
                    or self.side_by_side_active()
                    or self.join_active()
                ) and self.copy_checkbox is not None:
                    self.copy_checkbox.disable()

            self.render_button = ui.button("Render Output", icon="content_cut", on_click=self.render).props(
                "unelevated"
            ).classes("w-full")
            status_text = "Ready to preview or render." if active_info is not None else "Load clips to begin."
            self.status = ui.label(status_text).classes("muted")
            self.command_label = ui.label("").classes("command-box w-full")

            self.apply_source_defaults()

    def refresh_meta(self) -> None:
        if self.meta is None:
            return
        self.meta.clear()
        with self.meta:
            if self.info is None:
                if self.join_active():
                    ui.label(f"Using {len(self.join_infos)} clips as the join source.").classes("muted")
                else:
                    ui.label("No single source loaded. You can use Combine Clips instead.").classes("muted")
                return
            rows = [
                ("Type", "GIF" if self.info.kind == "gif" else "Video"),
                ("Duration", format_seconds(self.info.duration)),
                ("Size", f"{self.info.width or '-'} x {self.info.height or '-'}"),
                ("Codec", self.info.codec),
            ]
            if self.info.fps:
                rows.append(("FPS", f"{self.info.fps:.2f}"))
            if self.info.frame_count:
                rows.append(("Frames", self.info.frame_count))
            for label, value in rows:
                with ui.element("div").classes("metric-row"):
                    ui.label(label).classes("muted")
                    ui.label(value)

    def refresh_compare_meta(self) -> None:
        if self.compare_meta is None:
            return
        self.compare_meta.clear()
        with self.compare_meta:
            if self.compare_info is None:
                ui.label("No comparison media loaded.").classes("muted")
                return
            rows = [
                ("Type", "GIF" if self.compare_info.kind == "gif" else "Video"),
                ("Duration", format_seconds(self.compare_info.duration)),
                ("Size", f"{self.compare_info.width or '-'} x {self.compare_info.height or '-'}"),
                ("Codec", self.compare_info.codec),
            ]
            if self.compare_info.fps:
                rows.append(("FPS", f"{self.compare_info.fps:.2f}"))
            for label, value in rows:
                with ui.element("div").classes("metric-row"):
                    ui.label(label).classes("muted")
                    ui.label(value)

    def refresh_join_meta(self) -> None:
        if self.join_meta is None:
            return
        self.join_meta.clear()
        with self.join_meta:
            if not self.join_infos:
                ui.label("No clips loaded.").classes("muted")
            else:
                ui.label("Clips play top-to-bottom. Use the Preview panel to trim each one.").classes("muted")
            for index, info in enumerate(self.join_infos, start=1):
                selected = max(0.0, self.join_end_times[index - 1] - self.join_start_times[index - 1])
                with ui.row().classes("items-center w-full gap-1"):
                    ui.label(f"{index}. {info.path.name} ({format_seconds(selected)} selected)").classes("grow")
                    up_button = ui.button(
                        icon="arrow_upward", on_click=lambda i=index - 1: self.move_join_clip(i, -1)
                    ).props("flat dense")
                    down_button = ui.button(
                        icon="arrow_downward", on_click=lambda i=index - 1: self.move_join_clip(i, 1)
                    ).props("flat dense")
                    ui.button(icon="close", on_click=lambda i=index - 1: self.remove_join_clip(i)).props(
                        "flat dense"
                    )
                    ui.button(icon="edit", on_click=lambda i=index - 1: self.select_join_clip(i)).props("flat dense")
                    if index == 1:
                        up_button.disable()
                    if index == len(self.join_infos):
                        down_button.disable()
        if self.join_preview_button:
            if self.join_paths and not self.loading and not self.previewing_join:
                self.join_preview_button.enable()
            else:
                self.join_preview_button.disable()

    def invalidate_join_preview(self) -> None:
        if self.join_preview_path is not None:
            self.join_preview_path.unlink(missing_ok=True)
        self.join_preview_path = None

    def invalidate_rendered_join_output(self) -> None:
        self.invalidate_join_preview()
        self.output_path = None
        if self.output_meta:
            self.output_meta.set_text("No output rendered.")
        self.set_output_buttons(False)

    def move_join_clip(self, index: int, direction: int) -> None:
        next_index = index + direction
        if index < 0 or next_index < 0 or next_index >= len(self.join_paths):
            return
        self.join_revision += 1
        self.join_paths[index], self.join_paths[next_index] = self.join_paths[next_index], self.join_paths[index]
        self.join_infos[index], self.join_infos[next_index] = self.join_infos[next_index], self.join_infos[index]
        self.join_start_times[index], self.join_start_times[next_index] = (
            self.join_start_times[next_index], self.join_start_times[index]
        )
        self.join_end_times[index], self.join_end_times[next_index] = (
            self.join_end_times[next_index], self.join_end_times[index]
        )
        self.join_scrub_times[index], self.join_scrub_times[next_index] = (
            self.join_scrub_times[next_index], self.join_scrub_times[index]
        )
        self.join_video_preview_paths[index], self.join_video_preview_paths[next_index] = (
            self.join_video_preview_paths[next_index], self.join_video_preview_paths[index]
        )
        if self.join_selected_index == index:
            self.join_selected_index = next_index
        elif self.join_selected_index == next_index:
            self.join_selected_index = index
        if self.join_paths_input:
            self.join_paths_input.set_value("\n".join(str(path) for path in self.join_paths))
        self.invalidate_rendered_join_output()
        output_info = self.output_info()
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(output_info)) if output_info is not None else "")
        self.refresh_join_meta()
        self.preview_panel.refresh()
        self.set_status("Join order updated.")

    def remove_join_clip(self, index: int) -> None:
        if index < 0 or index >= len(self.join_paths):
            return
        self.join_revision += 1
        self.join_paths.pop(index)
        self.join_infos.pop(index)
        self.join_start_times.pop(index)
        self.join_end_times.pop(index)
        self.join_scrub_times.pop(index)
        self.join_video_preview_paths.pop(index)
        if self.join_selected_index > index:
            self.join_selected_index -= 1
        self.join_selected_index = min(self.join_selected_index, max(0, len(self.join_paths) - 1))
        self.join_enabled = bool(self.join_paths)
        if self.join_paths_input:
            self.join_paths_input.set_value("\n".join(str(path) for path in self.join_paths))
        self.invalidate_rendered_join_output()
        output_info = self.output_info()
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(output_info)) if output_info is not None else "")
        self.refresh_join_meta()
        self.preview_panel.refresh()
        self.controls_panel.refresh()
        self.set_status("Clip removed from join order.")

    def output_info(self) -> MediaInfo | None:
        if self.join_active() and self.join_infos:
            return self.join_infos[0]
        return self.info

    def output_timeline_duration(self) -> float:
        if self.join_active():
            return sum(
                max(0.0, end - start)
                for start, end in zip(self.join_start_times, self.join_end_times)
            )
        if self.info is None:
            return 0.0
        duration = max(0.0, self.end_time - self.start_time)
        if self.side_by_side_active():
            compare_duration = max(0.0, self.compare_end_time - self.compare_start_time)
            duration = min(duration, compare_duration)
        return duration

    def set_caption_text(self, value: Any) -> None:
        self.caption_text = str(value or "")
        self.invalidate_rendered_join_output()

    def set_caption_position(self, value: Any) -> None:
        position = str(value or "bottom")
        self.caption_position = position if position in {"top", "center", "bottom"} else "bottom"
        self.invalidate_rendered_join_output()

    def set_caption_size(self, value: Any) -> None:
        self.caption_size = max(12, min(96, int(parse_number(value, 36))))
        self.invalidate_rendered_join_output()

    def add_text_overlay(self) -> None:
        duration = self.output_timeline_duration()
        if duration <= 0:
            ui.notify("Load media with a positive duration before adding a timed overlay.", type="warning")
            return
        self.text_overlays.append(TextOverlay(text="", start=0.0, end=duration))
        self.invalidate_rendered_join_output()
        self.controls_panel.refresh()

    def remove_text_overlay(self, index: int) -> None:
        if index < 0 or index >= len(self.text_overlays):
            return
        self.text_overlays.pop(index)
        self.invalidate_rendered_join_output()
        self.controls_panel.refresh()

    def update_text_overlay(self, index: int, field: str, value: Any) -> None:
        if index < 0 or index >= len(self.text_overlays):
            return
        overlay = self.text_overlays[index]
        if field == "text":
            overlay.text = str(value or "")
        elif field == "start":
            overlay.start = max(0.0, parse_number(value, overlay.start))
        elif field == "end":
            overlay.end = max(0.0, parse_number(value, overlay.end))
        elif field == "position":
            position = str(value or "bottom")
            overlay.position = position if position in {"top", "center", "bottom"} else "bottom"
        elif field == "size":
            overlay.size = max(12, min(96, int(parse_number(value, overlay.size))))
        self.invalidate_rendered_join_output()

    def append_timed_overlay_args(self, cmd: list[str], output_duration: float) -> bool:
        active = False
        for index, overlay in enumerate(self.text_overlays, start=1):
            text = overlay.text.strip()
            if not text:
                continue
            if overlay.start < 0 or overlay.end <= overlay.start:
                raise ValueError(f"Overlay {index} end time must be greater than its start time.")
            if overlay.end > output_duration + 0.01:
                raise ValueError(
                    f"Overlay {index} ends at {format_seconds(overlay.end)}, past the "
                    f"{format_seconds(output_duration)} output duration."
                )
            cmd += [
                "--timed-text",
                text,
                "--timed-text-start",
                f"{overlay.start:.3f}",
                "--timed-text-end",
                f"{overlay.end:.3f}",
                "--timed-text-position",
                overlay.position,
                "--timed-text-size",
                str(overlay.size),
            ]
            active = True
        return active

    def output_base_size(self) -> tuple[int, int] | None:
        info = self.output_info()
        if info is None:
            return None
        if self.side_by_side_active():
            return 1920, 1080
        if info.width and info.height:
            return int(info.width), int(info.height)
        return None

    def normalize_output_dimension(self, value: float) -> int:
        info = self.output_info()
        if info is not None and info.kind == "video":
            return max(2, int(round(value / 2.0) * 2))
        return max(1, int(round(value)))

    def output_dimensions_from_scale(self, percent: float) -> tuple[int, int] | None:
        base_size = self.output_base_size()
        if base_size is None:
            return None
        base_width, base_height = base_size
        scale = max(10.0, min(parse_number(percent, 100.0), 100.0)) / 100.0
        return (
            self.normalize_output_dimension(base_width * scale),
            self.normalize_output_dimension(base_height * scale),
        )

    def set_output_dimensions(self, width: int, height: int, scale_percent: float | None = None) -> None:
        self.resize_syncing = True
        try:
            if self.width_input:
                self.width_input.set_value(width)
            if self.height_input:
                self.height_input.set_value(height)
            if scale_percent is not None:
                scale_percent = max(10.0, min(scale_percent, 100.0))
                if self.resize_scale_slider:
                    self.resize_scale_slider.set_value(scale_percent)
                if self.resize_scale_input:
                    self.resize_scale_input.set_value(round(scale_percent, 1))
            if self.output_size_label:
                self.output_size_label.set_text(f"Output: {width}x{height}")
        finally:
            self.resize_syncing = False

    def set_output_width(self, value: Any) -> None:
        if self.resize_syncing:
            return
        base_size = self.output_base_size()
        if base_size is None:
            return
        base_width, base_height = base_size
        width = self.normalize_output_dimension(parse_number(value, base_width))
        height = self.normalize_output_dimension(base_height * width / base_width)
        self.set_output_dimensions(width, height, width * 100.0 / base_width)

    def set_output_height(self, value: Any) -> None:
        if self.resize_syncing:
            return
        base_size = self.output_base_size()
        if base_size is None:
            return
        base_width, base_height = base_size
        height = self.normalize_output_dimension(parse_number(value, base_height))
        width = self.normalize_output_dimension(base_width * height / base_height)
        self.set_output_dimensions(width, height, height * 100.0 / base_height)

    def set_output_scale(self, value: Any) -> None:
        if self.resize_syncing:
            return
        percent = max(10.0, min(parse_number(value, 100.0), 100.0))
        dimensions = self.output_dimensions_from_scale(percent)
        if dimensions is None:
            return
        self.set_output_dimensions(dimensions[0], dimensions[1], percent)

    def apply_source_defaults(self) -> None:
        info = self.output_info()
        if info is None:
            return
        base_size = self.output_base_size()
        if base_size is not None:
            self.set_output_dimensions(base_size[0], base_size[1], 100.0)
        if self.fps_input and info.fps:
            self.fps_input.set_value(f"{info.fps:.2f}".rstrip("0").rstrip("."))

    def set_status(self, message: str) -> None:
        if self.status:
            self.status.set_text(message)

    def set_loading_state(self, loading: bool, message: str | None = None) -> None:
        self.loading = loading
        if message:
            self.set_status(message)
        for control in (
            self.source_upload,
            self.compare_upload,
            self.join_upload,
            self.path_input,
            self.compare_path_input,
            self.join_paths_input,
            self.render_button,
        ):
            if control is None:
                continue
            if loading:
                control.disable()
            else:
                control.enable()
        if self.join_preview_button:
            if not loading and self.join_paths and not self.previewing_join:
                self.join_preview_button.enable()
            else:
                self.join_preview_button.disable()

    def output_format_select_value(self) -> str:
        if self.side_by_side_active() or self.join_active():
            return "mp4"
        return self.output_format

    def target_output_kind(self) -> str:
        if self.join_active() or self.side_by_side_active():
            return "mp4"
        info = self.output_info()
        if info is None:
            return "gif"
        if self.output_format in {"gif", "mp4"}:
            return self.output_format
        return info.kind

    def set_output_format(self, value: Any) -> None:
        next_format = str(value or "auto")
        if next_format not in {"auto", "gif", "mp4"}:
            next_format = "auto"
        self.output_format = next_format
        info = self.output_info()
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(info)) if info is not None else "")
        self.apply_source_defaults()
        self.controls_panel.refresh()

    def trim_text(self) -> str:
        if self.info is None:
            return "0.00s selected"
        selected = max(0.0, self.end_time - self.start_time)
        return f"{format_seconds(self.start_time)} to {format_seconds(self.end_time)} ({format_seconds(selected)})"

    def compare_trim_text(self) -> str:
        if self.compare_info is None:
            return "0.00s selected"
        selected = max(0.0, self.compare_end_time - self.compare_start_time)
        return (
            f"{format_seconds(self.compare_start_time)} to "
            f"{format_seconds(self.compare_end_time)} ({format_seconds(selected)})"
        )

    def remember_pending_scrub_update(self, queue: list[tuple[float, float]], value: float) -> None:
        queue.append((value, time.monotonic()))
        del queue[:-20]

    def consume_pending_scrub_update(self, queue: list[tuple[float, float]], value: float) -> bool:
        now = time.monotonic()
        matched = False
        kept: list[tuple[float, float]] = []
        for pending_value, created_at in queue:
            if now - created_at > 1.0:
                continue
            if not matched and abs(pending_value - value) <= 0.05:
                matched = True
                continue
            kept.append((pending_value, created_at))
        queue[:] = kept[-20:]
        return matched

    async def run_preview_script(self, script: str) -> Any:
        try:
            return await ui.run_javascript(script, timeout=2)
        except Exception:
            return False

    async def handle_upload(self, event: events.UploadEventArguments) -> None:
        if self.loading:
            ui.notify("Another file is still loading.", type="warning")
            return
        filename = clean_filename(event.file.name)
        suffix = Path(filename).suffix.lower()
        if suffix not in ACCEPTED_SUFFIXES:
            ui.notify("Use a GIF or browser-friendly video file.", type="negative")
            return

        target = UPLOAD_DIR / f"{Path(filename).stem}-{secrets.token_hex(4)}{suffix}"
        self.set_loading_state(True, f"Uploading {filename}...")
        ui.notify(f"Uploading {filename}...", type="info")
        await asyncio.sleep(0)
        try:
            await event.file.save(target)
            await self.load_media(target)
        finally:
            self.set_loading_state(False)

    async def handle_compare_upload(self, event: events.UploadEventArguments) -> None:
        if self.loading:
            ui.notify("Another file is still loading.", type="warning")
            return
        filename = clean_filename(event.file.name)
        suffix = Path(filename).suffix.lower()
        if suffix not in ACCEPTED_SUFFIXES:
            ui.notify("Use a GIF or browser-friendly video file for side-by-side comparison.", type="negative")
            return

        target = UPLOAD_DIR / f"{Path(filename).stem}-{secrets.token_hex(4)}{suffix}"
        self.set_loading_state(True, f"Uploading {filename}...")
        ui.notify(f"Uploading {filename}...", type="info")
        await asyncio.sleep(0)
        try:
            await event.file.save(target)
            await self.load_compare_media(target)
        finally:
            self.set_loading_state(False)

    async def handle_join_upload(self, event: events.UploadEventArguments) -> None:
        async with self.join_upload_lock:
            if self.loading:
                ui.notify("Another file is still loading.", type="warning")
                return
            filename = clean_filename(event.file.name)
            suffix = Path(filename).suffix.lower()
            if suffix not in ACCEPTED_SUFFIXES:
                ui.notify("Use GIF or video files for joining.", type="negative")
                return

            target = UPLOAD_DIR / f"{Path(filename).stem}-{secrets.token_hex(4)}{suffix}"
            self.set_loading_state(True, f"Uploading {filename}...")
            ui.notify(f"Uploading {filename}...", type="info")
            await asyncio.sleep(0)
            try:
                await event.file.save(target)
                await self.load_join_paths([*self.join_paths, target], already_loading=True)
            finally:
                self.set_loading_state(False)

    async def load_path(self) -> None:
        if self.loading:
            ui.notify("Another file is still loading.", type="warning")
            return
        raw_path = (self.path_input.value or "").strip() if self.path_input else ""
        if not raw_path:
            ui.notify("Enter a local media path.", type="warning")
            return
        path = Path(raw_path).expanduser()
        await self.load_media(path)

    async def load_compare_path(self) -> None:
        if self.loading:
            ui.notify("Another file is still loading.", type="warning")
            return
        raw_path = (self.compare_path_input.value or "").strip() if self.compare_path_input else ""
        if not raw_path:
            ui.notify("Enter a second media path.", type="warning")
            return
        await self.load_compare_media(Path(raw_path).expanduser())

    async def load_join_paths_from_input(self) -> None:
        if self.loading:
            ui.notify("Another file is still loading.", type="warning")
            return
        raw_paths = self.join_paths_input.value if self.join_paths_input else ""
        paths = [Path(line.strip()).expanduser() for line in str(raw_paths or "").splitlines() if line.strip()]
        if not paths:
            self.clear_join()
            return
        await self.load_join_paths(paths)

    async def load_join_paths(self, paths: list[Path], *, already_loading: bool = False) -> None:
        paths = [path.expanduser() for path in paths]
        if not self.join_paths and self.info is not None and self.info.path not in paths:
            paths.insert(0, self.info.path)
        managed_loading = not already_loading and not self.loading
        if managed_loading:
            self.set_loading_state(True, "Loading clips to combine...")
        await asyncio.sleep(0)
        try:
            if not paths:
                self.clear_join()
                return
            for path in paths:
                if not path.exists() or not path.is_file():
                    raise ValueError(f"Join file was not found: {path}")

            existing: dict[Path, list[tuple[float, float, float, Path | None]]] = {}
            for index, old_path in enumerate(self.join_paths):
                existing.setdefault(old_path, []).append(
                    (
                        self.join_start_times[index],
                        self.join_end_times[index],
                        self.join_scrub_times[index],
                        self.join_video_preview_paths[index],
                    )
                )

            infos: list[MediaInfo] = []
            start_times: list[float] = []
            end_times: list[float] = []
            scrub_times: list[float] = []
            video_preview_paths: list[Path | None] = []
            for path in paths:
                self.set_status(f"Reading metadata for {path.name}...")
                info = await asyncio.to_thread(probe_media, path)
                infos.append(info)
                preserved = existing.get(path, [])
                if preserved:
                    start, end, scrub, video_preview_path = preserved.pop(0)
                    start_times.append(max(0.0, min(start, info.duration)))
                    end_times.append(max(start_times[-1], min(end, info.duration)))
                    scrub_times.append(max(start_times[-1], min(scrub, end_times[-1])))
                    video_preview_paths.append(video_preview_path)
                else:
                    start_times.append(0.0)
                    end_times.append(info.duration if info.duration > 0 else 1.0)
                    scrub_times.append(0.0)
                    video_preview_path = None
                    if info.kind == "gif":
                        self.set_status(f"Preparing preview for {path.name}...")
                        try:
                            video_preview_path = await asyncio.to_thread(ensure_gif_video_preview, path)
                        except Exception as exc:
                            ui.notify(f"Could not prepare GIF video preview for {path.name}: {exc}", type="warning")
                    video_preview_paths.append(video_preview_path)

            self.join_paths = paths
            self.join_infos = infos
            self.join_start_times = start_times
            self.join_end_times = end_times
            self.join_scrub_times = scrub_times
            self.join_video_preview_paths = video_preview_paths
            self.join_revision += 1
            self.join_enabled = bool(paths)
            self.compare_enabled = False
            self.invalidate_rendered_join_output()
            if self.join_paths_input:
                self.join_paths_input.set_value("\n".join(str(path) for path in paths))
            output_info = self.output_info()
            if self.output_input and output_info is not None:
                self.output_input.set_value(str(self.default_output_path(output_info)))
            if self.save_copy_input:
                self.save_copy_input.set_value("")
            if self.output_meta:
                self.output_meta.set_text("No output rendered.")
            self.set_output_buttons(False)
            self.refresh_meta()
            self.refresh_join_meta()
            self.preview_panel.refresh()
            self.controls_panel.refresh()
            self.set_status(f"Loaded {len(paths)} clip{'s' if len(paths) != 1 else ''} for the join source.")
            ui.notify(f"Loaded {len(paths)} clip{'s' if len(paths) != 1 else ''} to combine", type="positive")
        except Exception as exc:
            ui.notify(f"Could not load clips to combine: {exc}", type="negative")
            self.set_status("Could not load clips to combine.")
        finally:
            if managed_loading:
                self.set_loading_state(False)

    async def load_media(self, path: Path) -> None:
        path = path.expanduser()
        managed_loading = not self.loading
        if managed_loading:
            self.set_loading_state(True, f"Loading {path.name}...")
        else:
            self.set_status(f"Loading {path.name}...")
        await asyncio.sleep(0)
        if not path.exists() or not path.is_file():
            ui.notify("Source file was not found.", type="negative")
            if managed_loading:
                self.set_loading_state(False, "Source file was not found.")
            return
        self.stop_gif_playback()
        try:
            self.set_status(f"Reading metadata for {path.name}...")
            info = await asyncio.to_thread(probe_media, path)
        except Exception as exc:
            ui.notify(f"Could not read media: {exc}", type="negative")
            if managed_loading:
                self.set_loading_state(False, "Could not read media.")
            return

        try:
            self.info = info
            self.join_revision += 1
            self.invalidate_rendered_join_output()
            self.compare_enabled = self.compare_info is not None and not self.join_paths
            self.output_format = "auto"
            self.start_time = 0.0
            self.end_time = info.duration if info.duration > 0 else 1.0
            self.scrub_time = 0.0
            self.pending_scrub_updates.clear()
            self.gif_video_preview_path = None
            self.gif_preview_path = None
            self.gif_preview_frames = []
            self.gif_preview_frame_starts = []
            if info.kind == "gif":
                self.set_status(f"Preparing preview for {info.path.name}...")
                await asyncio.sleep(0)
                try:
                    self.gif_video_preview_path = await asyncio.to_thread(ensure_gif_video_preview, info.path)
                except Exception as exc:
                    ui.notify(f"Could not prepare video preview; using frame preview: {exc}", type="warning")
                    try:
                        await self.prepare_gif_preview(info)
                    except Exception as frame_exc:
                        ui.notify(f"Could not prepare GIF frame preview: {frame_exc}", type="negative")
            if self.path_input:
                self.path_input.set_value(str(info.path))
            if self.output_input:
                self.output_input.set_value(str(self.default_output_path(info)))
            if self.save_copy_input:
                self.save_copy_input.set_value("")
            if self.output_meta:
                self.output_meta.set_text("No output rendered.")
            self.set_output_buttons(False)
            self.refresh_meta()
            self.preview_panel.refresh()
            self.controls_panel.refresh()
            self.set_status(f"Loaded {info.path.name}.")
            ui.notify(f"Loaded {info.path.name}", type="positive")
        finally:
            if managed_loading:
                self.set_loading_state(False)

    async def load_compare_media(self, path: Path) -> None:
        path = path.expanduser()
        managed_loading = not self.loading
        if managed_loading:
            self.set_loading_state(True, f"Loading comparison {path.name}...")
        else:
            self.set_status(f"Loading comparison {path.name}...")
        await asyncio.sleep(0)
        if not path.exists() or not path.is_file():
            ui.notify("Comparison file was not found.", type="negative")
            if managed_loading:
                self.set_loading_state(False, "Comparison file was not found.")
            return
        try:
            self.set_status(f"Reading metadata for {path.name}...")
            info = await asyncio.to_thread(probe_media, path)
        except Exception as exc:
            ui.notify(f"Could not read comparison media: {exc}", type="negative")
            if managed_loading:
                self.set_loading_state(False, "Could not read comparison media.")
            return

        try:
            self.compare_info = info
            self.compare_video_preview_path = None
            if info.kind == "gif":
                self.set_status(f"Preparing comparison preview for {info.path.name}...")
                await asyncio.sleep(0)
                try:
                    self.compare_video_preview_path = await asyncio.to_thread(ensure_gif_video_preview, info.path)
                except Exception as exc:
                    ui.notify(f"Could not prepare comparison GIF video preview: {exc}", type="warning")
            self.compare_enabled = self.info is not None and not self.join_paths
            self.compare_start_time = 0.0
            self.compare_end_time = info.duration if info.duration > 0 else 1.0
            self.compare_scrub_time = 0.0
            self.pending_compare_scrub_updates.clear()
            if self.compare_path_input:
                self.compare_path_input.set_value(str(info.path))
            if self.output_input and self.info is not None:
                self.output_input.set_value(str(self.default_output_path(self.info)))
            if self.save_copy_input:
                self.save_copy_input.set_value("")
            self.refresh_compare_meta()
            self.preview_panel.refresh()
            self.controls_panel.refresh()
            self.set_status(f"Loaded comparison media {info.path.name}.")
            ui.notify(f"Loaded comparison media {info.path.name}", type="positive")
        finally:
            if managed_loading:
                self.set_loading_state(False)

    def default_output_path(self, info: MediaInfo) -> Path:
        output_dir = self.default_output_dir(info)
        if self.join_active():
            return output_dir / f"{info.path.stem}-joined.mp4"
        if self.compare_info is not None and self.compare_enabled:
            return output_dir / f"{info.path.stem}-vs-{self.compare_info.path.stem}.mp4"
        suffix = ".gif" if self.target_output_kind() == "gif" else ".mp4"
        return output_dir / f"{info.path.stem}-trimmed{suffix}"

    def default_output_dir(self, info: MediaInfo) -> Path:
        env_dir = os.environ.get("GIFTOOL_UI_OUTPUT_DIR")
        if env_dir:
            return Path(env_dir).expanduser()
        try:
            info.path.resolve().relative_to(UPLOAD_DIR.resolve())
        except ValueError:
            return info.path.parent
        videos_dir = Path.home() / "Videos" / "ClipFlip"
        return videos_dir if (Path.home() / "Videos").exists() else Path.home() / "ClipFlip"

    def use_default_output_path(self) -> None:
        info = self.output_info()
        if info is None:
            ui.notify("Load clips first.", type="warning")
            return
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(info)))

    def choose_output_path(self) -> None:
        info = self.output_info()
        if info is None:
            ui.notify("Load clips first.", type="warning")
            return
        selected = self.ask_save_path(self.default_output_path(info))
        if selected and self.output_input:
            self.output_input.set_value(selected)

    def set_output_buttons(self, enabled: bool) -> None:
        for button in (self.open_output_button, self.download_button, self.save_copy_button):
            if button is None:
                continue
            if enabled:
                button.enable()
            else:
                button.disable()

    def scrub_bounds(self) -> tuple[float, float]:
        if self.info is None:
            return 0.0, 1.0
        duration = max(0.01, self.info.duration)
        start = max(0.0, min(self.start_time, duration))
        end = self.end_time if self.end_time > 0 else duration
        end = max(start, min(end, duration))
        return start, end if end > start else min(duration, start + 0.01)

    def compare_scrub_bounds(self) -> tuple[float, float]:
        if self.compare_info is None:
            return 0.0, 1.0
        duration = max(0.01, self.compare_info.duration)
        start = max(0.0, min(self.compare_start_time, duration))
        end = self.compare_end_time if self.compare_end_time > 0 else duration
        end = max(start, min(end, duration))
        return start, end if end > start else min(duration, start + 0.01)

    def update_scrub_control_bounds(self) -> None:
        scrub_min, scrub_max = self.scrub_bounds()
        if self.scrub_slider:
            self.scrub_slider.props["min"] = scrub_min
            self.scrub_slider.props["max"] = scrub_max
        if self.scrub_input:
            self.scrub_input.props["min"] = scrub_min
            self.scrub_input.props["max"] = scrub_max

    def update_compare_scrub_control_bounds(self) -> None:
        scrub_min, scrub_max = self.compare_scrub_bounds()
        if self.compare_scrub_slider:
            self.compare_scrub_slider.props["min"] = scrub_min
            self.compare_scrub_slider.props["max"] = scrub_max
        if self.compare_scrub_input:
            self.compare_scrub_input.props["min"] = scrub_min
            self.compare_scrub_input.props["max"] = scrub_max

    def set_start(self, value: Any) -> None:
        if self.syncing:
            return
        if time.monotonic() < self.source_trim_event_guard_until:
            return
        if self.info is not None and self.info.kind == "gif":
            self.stop_gif_playback()
        duration = max(0.0, self.info.duration if self.info else 0.0)
        start = max(0.0, min(parse_number(value), duration))
        if self.end_time <= 0:
            self.end_time = duration
        if start > self.end_time:
            self.end_time = start
        self.start_time = start
        self.clamp_scrub_to_media()
        self.sync_trim_controls()

    def set_end(self, value: Any) -> None:
        if self.syncing:
            return
        if time.monotonic() < self.source_trim_event_guard_until:
            return
        if self.info is not None and self.info.kind == "gif":
            self.stop_gif_playback()
        duration = max(0.0, self.info.duration if self.info else 0.0)
        end = max(0.0, min(parse_number(value), duration))
        if end < self.start_time:
            self.start_time = end
        self.end_time = end
        self.clamp_scrub_to_media()
        self.sync_trim_controls()

    def clamp_scrub_to_media(self) -> None:
        if self.info is None:
            self.scrub_time = 0.0
            return
        scrub_min, scrub_max = self.scrub_bounds()
        self.scrub_time = max(scrub_min, min(self.scrub_time, scrub_max))

    def sync_trim_controls(self) -> None:
        self.syncing = True
        try:
            self.update_scrub_control_bounds()
            if self.start_slider:
                self.start_slider.set_value(self.start_time)
            if self.end_slider:
                self.end_slider.set_value(self.end_time)
            if self.start_input:
                self.start_input.set_value(round(self.start_time, 3))
            if self.end_input:
                self.end_input.set_value(round(self.end_time, 3))
            if self.trim_label:
                self.trim_label.set_text(self.trim_text())
            if self.scrub_slider:
                self.scrub_slider.set_value(self.scrub_time)
            if self.scrub_input:
                self.scrub_input.set_value(round(self.scrub_time, 3))
            self.update_gif_frame_preview()
        finally:
            self.syncing = False

    def sync_scrub_controls(self) -> None:
        self.syncing = True
        try:
            self.update_scrub_control_bounds()
            if self.scrub_slider or self.scrub_input:
                self.remember_pending_scrub_update(self.pending_scrub_updates, self.scrub_time)
            if self.scrub_slider:
                self.scrub_slider.set_value(self.scrub_time)
            if self.scrub_input:
                self.scrub_input.set_value(round(self.scrub_time, 3))
            self.update_gif_frame_preview()
        finally:
            self.syncing = False

    def on_preview_time_update(self, event: events.GenericEventArguments) -> None:
        raw_value = event.args[0] if isinstance(event.args, list) and event.args else event.args
        scrub_min, scrub_max = self.scrub_bounds()
        self.scrub_time = max(scrub_min, min(parse_number(raw_value, self.scrub_time), scrub_max))
        self.sync_scrub_controls()

    def on_source_media_error(self, event: events.GenericEventArguments) -> None:
        recovered = bool(event.args[0] if isinstance(event.args, list) and event.args else event.args)
        if recovered:
            self.set_status("Preview media had an error; reloading source preview.")
            ui.notify("Reloading source preview.", type="warning")
        else:
            self.set_status("Preview media could not reload automatically.")

    def on_compare_media_error(self, event: events.GenericEventArguments) -> None:
        recovered = bool(event.args[0] if isinstance(event.args, list) and event.args else event.args)
        if recovered:
            self.set_status("Comparison preview had an error; reloading preview.")
            ui.notify("Reloading comparison preview.", type="warning")
        else:
            self.set_status("Comparison preview could not reload automatically.")

    def on_output_media_error(self, event: events.GenericEventArguments) -> None:
        recovered = bool(event.args[0] if isinstance(event.args, list) and event.args else event.args)
        if recovered:
            self.set_status("Rendered preview had an error; reloading output preview.")
            ui.notify("Reloading output preview.", type="warning")
        else:
            self.set_status("Rendered preview could not reload automatically.")

    def full_range(self) -> None:
        if self.info is None:
            return
        if self.info.kind == "gif":
            self.stop_gif_playback()
        self.source_trim_event_guard_until = time.monotonic() + 0.75
        self.start_time = 0.0
        self.end_time = self.info.duration
        self.clamp_scrub_to_media()
        self.sync_trim_controls()

    def set_five_second_clip(self) -> None:
        if self.info is None:
            return
        if self.info.kind == "gif":
            self.stop_gif_playback()
        self.source_trim_event_guard_until = time.monotonic() + 0.75
        duration = max(0.0, self.info.duration)
        self.start_time = min(self.start_time, max(0.0, duration - 5.0))
        self.end_time = min(duration, self.start_time + 5.0)
        self.scrub_time = self.start_time
        self.clamp_scrub_to_media()
        self.sync_trim_controls()

    async def set_scrub(self, value: Any) -> None:
        if self.syncing:
            return
        scrub_min, scrub_max = self.scrub_bounds()
        next_time = max(scrub_min, min(parse_number(value), scrub_max))
        if self.consume_pending_scrub_update(self.pending_scrub_updates, next_time):
            return
        if self.info is not None and self.info.kind == "gif":
            self.stop_gif_playback()
        if abs(next_time - self.scrub_time) < 0.03:
            self.scrub_time = next_time
            self.sync_scrub_controls()
            return
        self.scrub_time = next_time
        self.sync_scrub_controls()
        if (
            self.info is not None
            and self.source_video is not None
            and (self.info.kind == "video" or self.gif_video_preview_path is not None)
        ):
            await self.run_preview_script(
                f"return window.giftoolSeekTrim({self.source_video.id}, {self.scrub_time:.6f})",
            )

    def preview_start_time(self) -> float:
        if self.start_time <= self.scrub_time < self.end_time:
            return self.scrub_time
        return self.start_time

    async def play_trim_range(self, loop: bool = False) -> None:
        if self.info is None or self.info.kind != "video" or self.source_video is None:
            ui.notify("Load a video first.", type="warning")
            return
        if self.end_time <= self.start_time:
            ui.notify("End time must be greater than start time.", type="warning")
            return
        preview_start = self.preview_start_time()
        ok = await self.run_preview_script(
            "return window.giftoolPlayTrim("
            f"{self.source_video.id}, {preview_start:.6f}, {self.end_time:.6f}, "
            f"{str(loop).lower()}, {self.start_time:.6f})",
        )
        if not ok:
            ui.notify("Could not start the trim preview.", type="negative")

    async def loop_trim_range(self) -> None:
        await self.play_trim_range(loop=True)

    async def pause_trim_preview(self) -> None:
        if self.source_video is None:
            return
        await self.run_preview_script(f"return window.giftoolPauseTrim({self.source_video.id})")

    def stop_gif_playback(self) -> None:
        task = self.gif_play_task
        if task is not None and not task.done():
            task.cancel()
        self.gif_play_task = None

    async def play_gif_range(self, loop: bool = False) -> None:
        if self.info is None or self.info.kind != "gif":
            ui.notify("Load a GIF first.", type="warning")
            return
        if self.end_time <= self.start_time:
            ui.notify("End time must be greater than start time.", type="warning")
            return

        if self.gif_video_preview_path is not None and self.source_video is not None:
            preview_start = self.preview_start_time()
            ok = await self.run_preview_script(
                "return window.giftoolPlayTrim("
                f"{self.source_video.id}, {preview_start:.6f}, {self.end_time:.6f}, "
                f"{str(loop).lower()}, {self.start_time:.6f})",
            )
            if not ok:
                ui.notify("Could not start the GIF preview.", type="negative")
            return

        if not self.gif_preview_frames:
            ui.notify("GIF preview frames are not ready.", type="warning")
            return
        self.stop_gif_playback()
        self.scrub_time = self.preview_start_time()
        self.sync_scrub_controls()
        self.gif_play_task = asyncio.create_task(self.run_gif_playback(loop))

    async def loop_gif_range(self) -> None:
        await self.play_gif_range(loop=True)

    async def pause_gif_preview(self) -> None:
        if self.gif_video_preview_path is not None and self.source_video is not None:
            await self.run_preview_script(f"return window.giftoolPauseTrim({self.source_video.id})")
            return
        self.stop_gif_playback()

    async def run_gif_playback(self, loop: bool) -> None:
        tick = 1.0 / GIF_PLAYBACK_UI_FPS
        last_tick = time.monotonic()
        try:
            while True:
                await asyncio.sleep(tick)
                now = time.monotonic()
                self.scrub_time += now - last_tick
                last_tick = now

                if self.scrub_time >= self.end_time:
                    if loop:
                        self.scrub_time = self.start_time
                        last_tick = time.monotonic()
                    else:
                        self.scrub_time = self.end_time
                        self.sync_scrub_controls()
                        break

                self.sync_scrub_controls()
        except asyncio.CancelledError:
            pass
        finally:
            if asyncio.current_task() is self.gif_play_task:
                self.gif_play_task = None

    def set_compare_start(self, value: Any) -> None:
        if self.syncing:
            return
        if time.monotonic() < self.compare_trim_event_guard_until:
            return
        duration = max(0.0, self.compare_info.duration if self.compare_info else 0.0)
        start = max(0.0, min(parse_number(value), duration))
        if self.compare_end_time <= 0:
            self.compare_end_time = duration
        if start > self.compare_end_time:
            self.compare_end_time = start
        self.compare_start_time = start
        self.clamp_compare_scrub_to_media()
        self.sync_compare_trim_controls()

    def set_compare_end(self, value: Any) -> None:
        if self.syncing:
            return
        if time.monotonic() < self.compare_trim_event_guard_until:
            return
        duration = max(0.0, self.compare_info.duration if self.compare_info else 0.0)
        end = max(0.0, min(parse_number(value), duration))
        if end < self.compare_start_time:
            self.compare_start_time = end
        self.compare_end_time = end
        self.clamp_compare_scrub_to_media()
        self.sync_compare_trim_controls()

    def clamp_compare_scrub_to_media(self) -> None:
        if self.compare_info is None:
            self.compare_scrub_time = 0.0
            return
        scrub_min, scrub_max = self.compare_scrub_bounds()
        self.compare_scrub_time = max(scrub_min, min(self.compare_scrub_time, scrub_max))

    def sync_compare_trim_controls(self) -> None:
        self.syncing = True
        try:
            self.update_compare_scrub_control_bounds()
            if self.compare_start_slider:
                self.compare_start_slider.set_value(self.compare_start_time)
            if self.compare_end_slider:
                self.compare_end_slider.set_value(self.compare_end_time)
            if self.compare_start_input:
                self.compare_start_input.set_value(round(self.compare_start_time, 3))
            if self.compare_end_input:
                self.compare_end_input.set_value(round(self.compare_end_time, 3))
            if self.compare_trim_label:
                self.compare_trim_label.set_text(self.compare_trim_text())
            if self.compare_scrub_slider or self.compare_scrub_input:
                self.remember_pending_scrub_update(self.pending_compare_scrub_updates, self.compare_scrub_time)
            if self.compare_scrub_slider:
                self.compare_scrub_slider.set_value(self.compare_scrub_time)
            if self.compare_scrub_input:
                self.compare_scrub_input.set_value(round(self.compare_scrub_time, 3))
        finally:
            self.syncing = False

    def sync_compare_scrub_controls(self) -> None:
        self.syncing = True
        try:
            self.update_compare_scrub_control_bounds()
            if self.compare_scrub_slider or self.compare_scrub_input:
                self.remember_pending_scrub_update(self.pending_compare_scrub_updates, self.compare_scrub_time)
            if self.compare_scrub_slider:
                self.compare_scrub_slider.set_value(self.compare_scrub_time)
            if self.compare_scrub_input:
                self.compare_scrub_input.set_value(round(self.compare_scrub_time, 3))
        finally:
            self.syncing = False

    def on_compare_time_update(self, event: events.GenericEventArguments) -> None:
        raw_value = event.args[0] if isinstance(event.args, list) and event.args else event.args
        scrub_min, scrub_max = self.compare_scrub_bounds()
        self.compare_scrub_time = max(scrub_min, min(parse_number(raw_value, self.compare_scrub_time), scrub_max))
        self.sync_compare_scrub_controls()

    def full_compare_range(self) -> None:
        if self.compare_info is None:
            return
        self.compare_trim_event_guard_until = time.monotonic() + 0.75
        self.compare_start_time = 0.0
        self.compare_end_time = self.compare_info.duration if self.compare_info.duration > 0 else 1.0
        self.clamp_compare_scrub_to_media()
        self.sync_compare_trim_controls()

    def set_compare_five_second_clip(self) -> None:
        if self.compare_info is None:
            return
        self.compare_trim_event_guard_until = time.monotonic() + 0.75
        duration = max(0.0, self.compare_info.duration)
        self.compare_start_time = min(self.compare_start_time, max(0.0, duration - 5.0))
        self.compare_end_time = min(duration, self.compare_start_time + 5.0)
        self.compare_scrub_time = self.compare_start_time
        self.clamp_compare_scrub_to_media()
        self.sync_compare_trim_controls()

    async def set_compare_scrub(self, value: Any) -> None:
        if self.syncing:
            return
        scrub_min, scrub_max = self.compare_scrub_bounds()
        next_time = max(scrub_min, min(parse_number(value), scrub_max))
        if self.consume_pending_scrub_update(self.pending_compare_scrub_updates, next_time):
            return
        if abs(next_time - self.compare_scrub_time) < 0.03:
            self.compare_scrub_time = next_time
            self.sync_compare_scrub_controls()
            return
        self.compare_scrub_time = next_time
        self.sync_compare_scrub_controls()
        if self.compare_info is not None and self.compare_video is not None:
            await self.run_preview_script(
                f"return window.giftoolSeekTrim({self.compare_video.id}, {self.compare_scrub_time:.6f})",
            )

    def compare_preview_start_time(self) -> float:
        if self.compare_start_time <= self.compare_scrub_time < self.compare_end_time:
            return self.compare_scrub_time
        return self.compare_start_time

    async def play_compare_trim_range(self, loop: bool = False) -> None:
        if self.compare_info is None or self.compare_video is None:
            ui.notify("Load comparison media first.", type="warning")
            return
        if self.compare_end_time <= self.compare_start_time:
            ui.notify("Second media end time must be greater than start time.", type="warning")
            return
        preview_start = self.compare_preview_start_time()
        ok = await self.run_preview_script(
            "return window.giftoolPlayTrim("
            f"{self.compare_video.id}, {preview_start:.6f}, {self.compare_end_time:.6f}, "
            f"{str(loop).lower()}, {self.compare_start_time:.6f})",
        )
        if not ok:
            ui.notify("Could not start the second trim preview.", type="negative")

    async def loop_compare_trim_range(self) -> None:
        await self.play_compare_trim_range(loop=True)

    async def pause_compare_trim_preview(self) -> None:
        if self.compare_video is None:
            return
        await self.run_preview_script(f"return window.giftoolPauseTrim({self.compare_video.id})")

    def set_compare_enabled(self, value: Any) -> None:
        self.compare_enabled = bool(value) and self.compare_info is not None
        if self.compare_enabled:
            self.join_enabled = False
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(self.info)) if self.info is not None else "")
        self.apply_source_defaults()
        if self.info is not None:
            self.controls_panel.refresh()

    def set_join_enabled(self, value: Any) -> None:
        self.join_enabled = bool(value) and bool(self.join_paths)
        if self.join_enabled:
            self.compare_enabled = False
        info = self.output_info()
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(info)) if info is not None else "")
        self.apply_source_defaults()
        self.preview_panel.refresh()
        self.controls_panel.refresh()

    def mp4_output_active(self) -> bool:
        return self.target_output_kind() == "mp4"

    def side_by_side_active(self) -> bool:
        return bool(
            self.info is not None
            and self.compare_info is not None
            and self.compare_enabled
        )

    def join_active(self) -> bool:
        return bool(self.join_infos and self.join_enabled)

    def clear_compare(self) -> None:
        self.compare_info = None
        self.compare_enabled = False
        self.compare_video_preview_path = None
        self.compare_start_time = 0.0
        self.compare_end_time = 0.0
        self.compare_scrub_time = 0.0
        self.compare_video = None
        self.compare_trim_label = None
        self.compare_start_slider = None
        self.compare_end_slider = None
        self.compare_scrub_slider = None
        self.compare_start_input = None
        self.compare_end_input = None
        self.compare_scrub_input = None
        self.pending_compare_scrub_updates.clear()
        if self.compare_path_input:
            self.compare_path_input.set_value("")
        if self.output_input and self.info is not None:
            self.output_input.set_value(str(self.default_output_path(self.info)))
        self.refresh_compare_meta()
        self.preview_panel.refresh()
        self.controls_panel.refresh()

    def clear_join(self) -> None:
        self.join_revision += 1
        self.join_paths = []
        self.join_infos = []
        self.join_start_times = []
        self.join_end_times = []
        self.join_scrub_times = []
        self.join_video_preview_paths = []
        self.join_selected_index = 0
        self.join_enabled = False
        self.invalidate_rendered_join_output()
        if self.join_paths_input:
            self.join_paths_input.set_value("")
        if self.output_input:
            self.output_input.set_value(str(self.default_output_path(self.info)) if self.info is not None else "")
        self.refresh_join_meta()
        self.refresh_meta()
        self.preview_panel.refresh()
        self.controls_panel.refresh()

    def reset(self) -> None:
        self.stop_gif_playback()
        self.info = None
        self.compare_info = None
        self.join_paths = []
        self.join_infos = []
        self.join_start_times = []
        self.join_end_times = []
        self.join_scrub_times = []
        self.join_video_preview_paths = []
        self.join_selected_index = 0
        self.compare_enabled = False
        self.join_enabled = False
        self.caption_text = ""
        self.caption_position = "bottom"
        self.caption_size = 36
        self.text_overlays = []
        self.invalidate_rendered_join_output()
        self.output_format = "auto"
        self.start_time = 0.0
        self.end_time = 0.0
        self.scrub_time = 0.0
        self.compare_start_time = 0.0
        self.compare_end_time = 0.0
        self.compare_scrub_time = 0.0
        self.source_video = None
        self.compare_video = None
        self.gif_frame_image = None
        self.gif_video_preview_path = None
        self.compare_video_preview_path = None
        self.gif_preview_path = None
        self.gif_preview_frames = []
        self.gif_preview_frame_starts = []
        self.compare_trim_label = None
        self.compare_start_slider = None
        self.compare_end_slider = None
        self.compare_scrub_slider = None
        self.compare_start_input = None
        self.compare_end_input = None
        self.compare_scrub_input = None
        self.pending_scrub_updates.clear()
        self.pending_compare_scrub_updates.clear()
        if self.path_input:
            self.path_input.set_value("")
        if self.compare_path_input:
            self.compare_path_input.set_value("")
        if self.join_paths_input:
            self.join_paths_input.set_value("")
        if self.output_input:
            self.output_input.set_value("")
        if self.save_copy_input:
            self.save_copy_input.set_value("")
        if self.output_meta:
            self.output_meta.set_text("No output rendered.")
        self.set_output_buttons(False)
        self.refresh_meta()
        self.refresh_compare_meta()
        self.refresh_join_meta()
        self.preview_panel.refresh()
        self.controls_panel.refresh()

    def output_dimension_value(self, control: Any) -> str:
        if control is None or control.value in (None, ""):
            return ""
        value = parse_number(control.value, 0.0)
        if value <= 0:
            return ""
        return str(int(round(value)))

    def build_command(self, output_path: Path) -> list[str]:
        if self.join_active():
            return self.build_join_command(output_path)
        if self.info is None:
            raise ValueError("Load media before rendering.")
        if self.end_time <= self.start_time:
            raise ValueError("End time must be greater than start time.")

        selected_duration = self.end_time - self.start_time
        comparison_active = self.side_by_side_active()
        joining_active = False
        target_kind = self.target_output_kind()
        mp4_output = target_kind == "mp4"
        backend = SCRIPT_DIR / ("videotool" if target_kind == "mp4" else "giftool")
        cmd = [str(backend), "-i", str(self.info.path), "-o", str(output_path)]

        output_duration = selected_duration
        if comparison_active and self.compare_info is not None:
            if self.compare_end_time <= self.compare_start_time:
                raise ValueError("Second media end time must be greater than start time.")
            output_duration = min(selected_duration, self.compare_end_time - self.compare_start_time)
            if output_duration <= 0:
                raise ValueError("Side-by-side trim ranges must have positive duration.")
        if self.start_time > 0:
            cmd += ["-s", f"{self.start_time:.3f}"]
        if comparison_active or self.end_time < self.info.duration:
            cmd += ["-d", f"{output_duration:.3f}"]

        width = self.output_dimension_value(self.width_input)
        height = self.output_dimension_value(self.height_input)
        fps = (self.fps_input.value or "").strip() if self.fps_input else ""
        source_width = str(self.info.width or "")
        source_height = str(self.info.height or "")
        source_fps = f"{self.info.fps:.2f}".rstrip("0").rstrip(".") if self.info.fps else ""

        if width and width != source_width:
            cmd += ["-w", width]
        if height and height != source_height:
            cmd += ["-h", height]
        if fps and fps != source_fps:
            cmd += ["-f", fps]

        if not mp4_output:
            loop = (self.loop_input.value or "").strip() if self.loop_input else "0"
            if loop:
                cmd += ["--loop", loop]
        else:
            caption = (self.caption_input.value or "").strip() if self.caption_input else self.caption_text.strip()
            self.caption_text = caption
            if comparison_active and self.compare_info is not None:
                cmd += ["--compare", str(self.compare_info.path)]
                if self.compare_start_time > 0:
                    cmd += ["--compare-start", f"{self.compare_start_time:.3f}"]
                cmd += ["--compare-duration", f"{output_duration:.3f}"]
                label_left = (self.label_left_input.value or "").strip() if self.label_left_input else ""
                label_right = (self.label_right_input.value or "").strip() if self.label_right_input else ""
                if label_left:
                    cmd += ["--label-left", label_left]
                if label_right:
                    cmd += ["--label-right", label_right]
            if caption:
                position = self.text_position_select.value if self.text_position_select else self.caption_position
                size = (
                    int(self.text_size_input.value)
                    if self.text_size_input and self.text_size_input.value
                    else self.caption_size
                )
                self.caption_position = str(position)
                self.caption_size = size
                cmd += ["--text", caption, "--text-position", str(position), "--text-size", str(size)]

            timed_overlay_active = self.append_timed_overlay_args(cmd, output_duration)

            copy_mode = bool(self.copy_checkbox.value) if self.copy_checkbox and self.info.kind == "video" else False
            has_filters = any(flag in cmd for flag in ("-w", "-h", "-f"))
            if (
                copy_mode
                and not has_filters
                and not comparison_active
                and not joining_active
                and not caption
                and not timed_overlay_active
            ):
                cmd.append("--copy")
            else:
                crf = int(self.crf_slider.value) if self.crf_slider else 20
                preset = self.preset_select.value if self.preset_select else "medium"
                cmd += ["--crf", str(crf), "--preset", str(preset)]

        return cmd

    def build_join_command(self, output_path: Path) -> list[str]:
        if not self.join_infos:
            raise ValueError("Add clips before rendering a join.")
        for index, info in enumerate(self.join_infos):
            if self.join_end_times[index] <= self.join_start_times[index]:
                raise ValueError(f"Clip {index + 1} end time must be greater than start time.")
            if self.join_end_times[index] > info.duration + 0.01:
                raise ValueError(f"Clip {index + 1} trim extends past the end of the media.")

        first_info = self.join_infos[0]
        cmd = [str(SCRIPT_DIR / "videotool"), "-i", str(first_info.path), "-o", str(output_path)]
        if self.join_start_times[0] > 0:
            cmd += ["-s", f"{self.join_start_times[0]:.3f}"]
        cmd += ["-d", f"{self.join_end_times[0] - self.join_start_times[0]:.3f}"]

        for index, info in enumerate(self.join_infos[1:], start=1):
            cmd += ["--concat", str(info.path)]
            if self.join_start_times[index] > 0:
                cmd += ["--concat-start", f"{self.join_start_times[index]:.3f}"]
            cmd += ["--concat-duration", f"{self.join_end_times[index] - self.join_start_times[index]:.3f}"]

        width = self.output_dimension_value(self.width_input)
        height = self.output_dimension_value(self.height_input)
        fps = (self.fps_input.value or "").strip() if self.fps_input else ""
        source_width = str(first_info.width or "")
        source_height = str(first_info.height or "")
        source_fps = f"{first_info.fps:.2f}".rstrip("0").rstrip(".") if first_info.fps else ""
        if width and width != source_width:
            cmd += ["-w", width]
        if height and height != source_height:
            cmd += ["-h", height]
        if fps and fps != source_fps:
            cmd += ["-f", fps]

        caption = (self.caption_input.value or "").strip() if self.caption_input else self.caption_text.strip()
        self.caption_text = caption
        if caption:
            position = self.text_position_select.value if self.text_position_select else self.caption_position
            size = (
                int(self.text_size_input.value)
                if self.text_size_input and self.text_size_input.value
                else self.caption_size
            )
            self.caption_position = str(position)
            self.caption_size = size
            cmd += ["--text", caption, "--text-position", str(position), "--text-size", str(size)]
        output_duration = sum(
            end - start for start, end in zip(self.join_start_times, self.join_end_times)
        )
        self.append_timed_overlay_args(cmd, output_duration)
        crf = int(self.crf_slider.value) if self.crf_slider else 20
        preset = self.preset_select.value if self.preset_select else "medium"
        cmd += ["--crf", str(crf), "--preset", str(preset)]
        return cmd

    async def preview_join(self) -> None:
        if self.previewing_join:
            ui.notify("Join preview is already rendering.", type="warning")
            return
        if not self.join_paths or not self.join_enabled:
            ui.notify("Add clips and enable Combine clips in order first.", type="warning")
            return

        PREVIEW_DIR.mkdir(parents=True, exist_ok=True)
        token = secrets.token_hex(4)
        preview_revision = self.join_revision
        preview_output = PREVIEW_DIR / f"join-preview-{token}.mp4"
        temporary_output = PREVIEW_DIR / f".join-preview-{token}.tmp.mp4"
        try:
            cmd = self.build_command(temporary_output)
            cmd += ["-w", "640", "-h", "360", "-f", "24", "--crf", "32", "--preset", "ultrafast"]
        except Exception as exc:
            ui.notify(str(exc), type="negative")
            return

        self.previewing_join = True
        if self.join_preview_button:
            self.join_preview_button.disable()
        self.set_status("Rendering join preview...")
        try:
            await asyncio.to_thread(subprocess.run, cmd, check=True, capture_output=True, text=True)
            if not temporary_output.exists() or temporary_output.stat().st_size <= 0:
                raise OSError("ffmpeg completed without producing a preview file.")
            if preview_revision != self.join_revision:
                temporary_output.unlink(missing_ok=True)
                self.set_status("Join order changed; preview discarded.")
                return
            old_preview = self.join_preview_path
            temporary_output.replace(preview_output)
            self.join_preview_path = preview_output
            if old_preview is not None:
                old_preview.unlink(missing_ok=True)
            self.preview_panel.refresh()
            self.set_status("Join preview ready.")
            ui.notify("Join preview ready.", type="positive")
        except subprocess.CalledProcessError as exc:
            temporary_output.unlink(missing_ok=True)
            message = (exc.stderr or exc.stdout or "Join preview failed.").strip()
            ui.notify(message[:500], type="negative")
            self.set_status("Join preview failed.")
        except Exception as exc:
            temporary_output.unlink(missing_ok=True)
            ui.notify(f"Could not create join preview: {exc}", type="negative")
            self.set_status("Join preview failed.")
        finally:
            self.previewing_join = False
            self.refresh_join_meta()

    async def render(self) -> None:
        if self.rendering:
            ui.notify("Render already in progress.", type="warning")
            return
        output_info = self.output_info()
        if output_info is None:
            ui.notify("Load clips first.", type="warning")
            return

        raw_output = (self.output_input.value or "").strip() if self.output_input else ""
        output_path = Path(raw_output).expanduser() if raw_output else self.default_output_path(output_info)
        target_kind = self.target_output_kind()
        if not output_path.suffix:
            output_path = output_path.with_suffix(".mp4" if target_kind == "mp4" else ".gif")
        if target_kind == "mp4" and output_path.suffix.lower() != ".mp4":
            output_path = output_path.with_suffix(".mp4")
        elif target_kind == "gif" and output_path.suffix.lower() != ".gif":
            output_path = output_path.with_suffix(".gif")

        source_paths = list(self.join_paths) if self.join_active() else [output_info.path]
        if self.side_by_side_active() and self.compare_info is not None:
            source_paths.append(self.compare_info.path)
        try:
            resolved_output = output_path.resolve()
            if any(resolved_output == source_path.resolve() for source_path in source_paths):
                raise ValueError("Output path must be different from every input clip.")
        except OSError as exc:
            ui.notify(f"Could not validate output path: {exc}", type="negative")
            return

        temporary_output = output_path.with_name(
            f".{output_path.name}.{secrets.token_hex(4)}.tmp{output_path.suffix}"
        )
        try:
            output_path.parent.mkdir(parents=True, exist_ok=True)
            cmd = self.build_command(temporary_output)
        except Exception as exc:
            ui.notify(str(exc), type="negative")
            return

        if self.command_label:
            display_cmd = [*cmd]
            display_cmd[display_cmd.index("-o") + 1] = str(output_path)
            self.command_label.set_text(shell_join(display_cmd))
        if self.status:
            self.status.set_text("Rendering...")
        self.rendering = True
        if self.render_button:
            self.render_button.disable()

        try:
            await asyncio.to_thread(subprocess.run, cmd, check=True, capture_output=True, text=True)
        except subprocess.CalledProcessError as exc:
            temporary_output.unlink(missing_ok=True)
            message = (exc.stderr or exc.stdout or "Render failed.").strip()
            ui.notify(message[:500], type="negative")
            if self.status:
                self.status.set_text("Render failed.")
            return
        except OSError as exc:
            temporary_output.unlink(missing_ok=True)
            ui.notify(f"Could not start render: {exc}", type="negative")
            if self.status:
                self.status.set_text("Render could not start.")
            return
        except Exception as exc:
            temporary_output.unlink(missing_ok=True)
            ui.notify(f"Render failed unexpectedly: {exc}", type="negative")
            if self.status:
                self.status.set_text("Render failed unexpectedly.")
            return
        finally:
            self.rendering = False
            if self.render_button:
                self.render_button.enable()

        try:
            if not temporary_output.exists() or temporary_output.stat().st_size <= 0:
                raise OSError("ffmpeg completed without producing an output file.")
            temporary_output.replace(output_path)
        except OSError as exc:
            temporary_output.unlink(missing_ok=True)
            ui.notify(f"Could not finalize rendered output: {exc}", type="negative")
            if self.status:
                self.status.set_text("Render finalization failed.")
            return

        self.output_path = output_path
        if self.output_input:
            self.output_input.set_value(str(output_path))
        if self.output_meta:
            size_mb = output_path.stat().st_size / (1024 * 1024)
            self.output_meta.set_text(f"Rendered {output_path} ({size_mb:.2f} MB)")
        if self.save_copy_input:
            self.save_copy_input.set_value(str(output_path))
        if self.status:
            self.status.set_text("Render complete.")
        self.set_output_buttons(True)
        self.preview_panel.refresh()
        ui.notify("Render complete.", type="positive")

    def open_output_external(self) -> None:
        if self.output_path is None or not self.output_path.exists():
            ui.notify("Render an output first.", type="warning")
            return
        try:
            subprocess.Popen(
                ["ffplay", "-autoexit", "-window_title", self.output_path.name, str(self.output_path)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception as exc:
            ui.notify(f"Could not launch ffplay: {exc}", type="negative")

    def download_output(self) -> None:
        if self.output_path is None or not self.output_path.exists():
            ui.notify("Render an output first.", type="warning")
            return
        ui.download(str(self.output_path), filename=self.output_path.name)

    def ask_save_path(self, initial_path: Path) -> str:
        try:
            import tkinter as tk
            from tkinter import filedialog

            root = tk.Tk()
            root.withdraw()
            root.attributes("-topmost", True)
            selected = filedialog.asksaveasfilename(
                initialdir=str(initial_path.parent),
                initialfile=initial_path.name,
                defaultextension=initial_path.suffix,
                filetypes=[
                    ("Media file", f"*{initial_path.suffix}" if initial_path.suffix else "*"),
                    ("All files", "*"),
                ],
            )
            root.destroy()
        except Exception as exc:
            ui.notify(f"Could not open save dialog: {exc}", type="negative")
            return ""

        return selected or ""

    def choose_save_copy_path(self) -> None:
        initial_path = self.output_path
        info = self.output_info()
        if initial_path is None and info is not None:
            initial_path = self.default_output_path(info)
        if initial_path is None:
            ui.notify("Load or render media before choosing a save path.", type="warning")
            return

        selected = self.ask_save_path(initial_path)
        if selected and self.save_copy_input:
            self.save_copy_input.set_value(selected)

    async def save_output_copy(self) -> None:
        if self.output_path is None or not self.output_path.exists():
            ui.notify("Render an output first.", type="warning")
            return
        raw_target = (self.save_copy_input.value or "").strip() if self.save_copy_input else ""
        if not raw_target:
            ui.notify("Enter a destination path for the rendered copy.", type="warning")
            return

        target = Path(raw_target).expanduser()
        if target.exists() and target.is_dir():
            target = target / self.output_path.name
        if not target.suffix:
            target = target.with_suffix(self.output_path.suffix)
        if target == self.output_path:
            ui.notify("The rendered file is already at that path.", type="info")
            return

        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            await asyncio.to_thread(shutil.copy2, self.output_path, target)
        except Exception as exc:
            ui.notify(f"Could not save copy: {exc}", type="negative")
            self.set_status("Save copy failed.")
            return

        if self.save_copy_input:
            self.save_copy_input.set_value(str(target))
        size_mb = target.stat().st_size / (1024 * 1024)
        if self.output_meta:
            self.output_meta.set_text(f"Saved copy to {target} ({size_mb:.2f} MB)")
        self.set_status(f"Saved copy to {target}.")
        ui.notify(f"Saved copy to {target}", type="positive")


def main() -> None:
    args = parse_args(sys.argv[1:])
    if args.native:
        try:
            import webview  # noqa: F401
        except ModuleNotFoundError as exc:
            print(
                "pywebview is required for native mode.\n"
                "Install it with:\n"
                "  ./install-deps --native\n"
                "or:\n"
                "  python3 -m pip install --user pywebview",
                file=sys.stderr,
            )
            raise SystemExit(1) from exc

    tool = TrimTool()
    tool.build()
    port = args.port
    if port is None and not args.native:
        port = 8080
    window_size = args.window_size
    if args.native and window_size is None:
        window_size = (1440, 960)
    ui.run(
        title="ClipFlip Studio",
        host=args.host,
        port=port,
        native=args.native,
        window_size=window_size,
        fullscreen=args.fullscreen,
        frameless=args.frameless,
        reload=False,
        show=False if args.native else not args.no_show,
    )


if __name__ in {"__main__", "__mp_main__"}:
    main()
