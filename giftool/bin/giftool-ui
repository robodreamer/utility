    def build(self) -> None:
        ui.page_title("ClipFlip Studio")
        ui.colors(primary="#2563eb", secondary="#0f766e", accent="#d97706")
        ui.add_head_html(
            """
            <script>
              window.giftoolTrimTimers = window.giftoolTrimTimers || {};

              window.giftoolPauseTrim = (videoId) => {
                const component = getElement(videoId);
                const video = component && component.$el;
                if (!video) return false;
                if (window.giftoolTrimTimers[videoId]) {
                  clearInterval(window.giftoolTrimTimers[videoId]);
                  delete window.giftoolTrimTimers[videoId];
                }
                video.pause();
                return true;
              };

              window.giftoolSeekTrim = (videoId, time) => {
                const component = getElement(videoId);
                const video = component && component.$el;
                if (!video || !Number.isFinite(time)) return false;
                window.giftoolPauseTrim(videoId);
                video.currentTime = time;
                return true;
              };

              window.giftoolPlayTrim = (videoId, start, end, loop = false, loopStart = start) => {
                const component = getElement(videoId);
                const video = component && component.$el;
                if (!video || !Number.isFinite(start) || !Number.isFinite(end) || end <= start) return false;

                window.giftoolPauseTrim(videoId);

                const stopAtEnd = () => {
                  if (video.currentTime >= end || video.ended) {
                    if (loop) {
                      video.currentTime = loopStart;
                      const playResult = video.play();
                      if (playResult && playResult.catch) {
                        playResult.catch((error) => console.warn("Preview playback failed", error));
                      }
                    } else {
                      video.pause();
                      video.currentTime = end;
                      clearInterval(window.giftoolTrimTimers[videoId]);
                      delete window.giftoolTrimTimers[videoId];
                    }
                  }
                };

                const begin = () => {
                  video.currentTime = start;
                  window.giftoolTrimTimers[videoId] = setInterval(stopAtEnd, 50);
                  const playResult = video.play();
                  if (playResult && playResult.catch) {
                    playResult.catch((error) => console.warn("Preview playback failed", error));
                  }
                };

                if (video.readyState < 1) {
                  video.addEventListener("loadedmetadata", begin, {once: true});
                  video.load();
                } else {
                  begin();
                }

                return true;
              };

              window.giftoolRecoverMedia = (videoId) => {
                const component = getElement(videoId);
                const video = component && component.$el;
                if (!video) return false;
                const now = Date.now();
                const lastReload = Number(video.dataset.giftoolLastReload || 0);
                if (now - lastReload < 1500) return false;
                video.dataset.giftoolLastReload = String(now);
                try {
                  video.pause();
                  video.currentTime = 0;
                } catch (error) {
                  console.warn("Preview reset failed", error);
                }
                video.load();
                return true;
              };
            </script>
            <style>
              body {
                background: #f6f8fb;
                color: #172033;
              }
              .app-shell {
                max-width: 1440px;
                margin: 0 auto;
                padding: 18px;
              }
              .app-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 14px;
              }
              .brand-mark {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: #172033;
                color: #ffffff;
                display: grid;
                place-items: center;
                font-weight: 700;
              }
              .brand-logo {
                width: 40px;
                height: 40px;
                border-radius: 10px;
              }
              .tool-grid {
                display: grid;
                grid-template-columns: minmax(280px, 360px) minmax(380px, 1fr) minmax(300px, 390px);
                gap: 14px;
                align-items: start;
              }
              .panel {
                background: #ffffff;
                border: 1px solid #dbe2ec;
                border-radius: 8px;
                box-shadow: 0 8px 24px rgba(25, 33, 52, 0.06);
                padding: 16px;
              }
              .section-title {
                color: #172033;
                font-size: 0.95rem;
                font-weight: 700;
                letter-spacing: 0;
              }
              .muted {
                color: #64748b;
                font-size: 0.86rem;
              }
              .preview-surface {
                background: #111827;
                border: 1px solid #243244;
                border-radius: 8px;
                min-height: 420px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
              }
              .media-view {
                width: 100%;
                max-height: 560px;
                object-fit: contain;
                background: #111827;
              }
              .preview-tab-panel {
                padding: 0;
              }
              .preview-tab-content {
                width: 100%;
              }
              .trim-controls {
                width: 100%;
                border-top: 1px solid #dbe2ec;
                padding-top: 12px;
              }
              .empty-preview {
                color: #cbd5e1;
                text-align: center;
              }
              .command-box {
                background: #0f172a;
                color: #dbeafe;
                border-radius: 8px;
                padding: 12px;
                font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                font-size: 0.78rem;
